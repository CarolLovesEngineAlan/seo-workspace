# 复制为 .env 或 .env.local 后填写。勿将真实密钥提交到 Git。

# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Supabase（用于 page_opportunities 快照、opportunity_supplements、brief records 与权限）
SUPABASE_URL=
# 或 NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# 用于浏览器 Google 登录，填写 Project Settings → API 的 anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 可选：本地文档说明用；Vercel 线上建议留空或填写正式域名，勿配置成 http://localhost:3000
NEXT_PUBLIC_APP_URL=
# 可选：仅在你需要覆盖默认 /auth/callback 时设置；线上勿配置成 localhost
NEXT_PUBLIC_AUTH_REDIRECT_URL=
# 用于 Google One Tap，填写 Google Cloud OAuth Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 须填 Project Settings → API 的 service_role secret（勿填 anon/public key，否则会 Invalid API key）
SUPABASE_SERVICE_ROLE_KEY=
# 首次管理员白名单，多个邮箱用逗号分隔。首次通过 Google 登录后会自动授予 admin
AUTH_ADMIN_EMAILS=

# OpenAI（用于生成 brief / article draft）
OPENAI_API_KEY=
# 可选：默认使用 gpt-4.1-mini
OPENAI_BRIEF_MODEL=
# 可选：默认沿用 OPENAI_MODEL 或 gpt-4.1-mini
OPENAI_DRAFT_MODEL=
# 可选：若本机外网需走本地代理，可设置为 http://127.0.0.1:7890（如 Clash mixed-port）
OPENAI_HTTP_PROXY=
# 可选：若当前网络无法直连 api.openai.com，可改为兼容 Responses API 的网关基础地址，例如 https://your-gateway.example.com/v1
OPENAI_BASE_URL=

# Serper（用于内容策略 SERP 调研，https://serper.dev）
SERPER_API_KEY=
# 可选：指定内容策略生成模型，默认与 OPENAI_BRIEF_MODEL 相同
OPENAI_STRATEGY_MODEL=

# Vercel Cron 专用路由校验
CRON_SECRET=

# 可选：仅用于文档/本地说明；Vercel 实际定时频率在 vercel.json 的 crons 中配置
# 当前仓库配置为每天北京时间 00:00（UTC 16:00）执行一次 Notion -> Supabase 快照同步
CRON_JOB_SCHEDULE=0 16 * * *
CRON_JOB_TIMEZONE=Asia/Shanghai
